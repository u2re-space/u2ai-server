{
  "name": "@u2ai/server",
  "version": "0.3.0",
  "description": "Agent service and server: an MCP server with tools, a bus for editor extensions, and a completion bridge.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./shared": "./src/shared/house/shared.js",
    "./protocol": "./src/shared/house/protocol.js",
    "./worker": "./src/shared/house/worker.js",
    "./code-mode": "./src/shared/house/code-mode.js",
    "./code-libraries": "./src/shared/house/code-libraries.js",
    "./ramdisk": "./src/access/ramdisk.js"
  },
  "bin": {
    "ai-serve": "./bin/ai-serve.js",
    "ai-serve-worker": "./bin/ai-serve-worker.js",
    "ai-serve-agent-worker": "./bin/ai-serve-agent-worker.js",
    "ai-serve-code-mode-worker": "./bin/ai-serve-code-mode-worker.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u2re-space/u2ai-server.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/ai-serve.js",
    "test": "node --test --test-timeout=60000 --import ./test/offline-guard.js \"test/*.test.js\"",
    "check": "node scripts/check-syntax.mjs"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "README.md"
  ],
  "keywords": [
    "openai",
    "responses-api",
    "cli",
    "mcp",
    "model-context-protocol",
    "websocket",
    "agent",
    "autocomplete"
  ],
  "license": "MIT",
  "dependencies": {
    "@u2ai/subagent": "file:../u2ai-subagent",
    "terminal-kit": "^3.1.4"
  }
}
